import "tfplan/v2" as tfplan

# Define allowed instance types
allowed_instance_types = [
	"t3.micro",
	"t3.small",
	"t3.medium",
]

# Filter for all managed EC2 instances in the plan (skipping destroys)
aws_instances = filter tfplan.resource_changes else {} as _, rc {
	rc.type is "aws_instance" and
	rc.mode is "managed" and
	rc.change.after is not null
}

# Rule to check all filtered aws_instance resources
main = rule {
	all aws_instances as _, instance {
		instance.change.after.instance_type in allowed_instance_types
	}
}